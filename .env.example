# Maple Court Tenant Assistant - copy to .env and fill in the two API keys.

# --- API Keys ---
OPENAI_API_KEY=

# Cohere rerank - a trial key works ~10 calls/minute
CO_API_KEY=

# --- Database  ---
DATABASE_URL=postgresql+asyncpg://postgres:<insert_password_here>@postgres:5432/tenant

# --- LangSmith Tracing ---
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tenant-rag

# --- Redis Semantic Cache ---
REDIS_URL=redis://redis:6379/0
CACHE_DISTANCE_THRESHOLD=0.05

# --- App ---
PROPERTY_TZ=America/Los_Angeles
DATA_DIR=data

# --- Retrieval ---
RETRIEVAL_K=20           
RETRIEVAL_PER_DOC=5      
RERANK_TOP_N=8            

# --- Hybrid retrieval (app/hybrid.py) ---
HYBRID_RETRIEVAL=true     # false = vector-only, for A/B comparison without a code change
RRF_K=60                 
HYBRID_DENSE_WEIGHT=1.0
HYBRID_LEXICAL_WEIGHT=1.0